FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

// Inlet omega = sqrt(k) / (Cmu^0.25 * 0.05 D), D = longest side of the model.
dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omega_in;

boundaryField
{
    inlet
    {
$inlet
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform $omega_in;
        value           uniform $omega_in;
    }

    sides
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    floor
    {
$floor
    }

    model
    {
        type            omegaWallFunction;
        value           uniform $omega_in;
    }
}
