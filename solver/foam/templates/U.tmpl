FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ($speed 0 0);

boundaryField
{
    inlet
    {
$inlet
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    sides
    {
        type            slip;
    }

    top
    {
        type            slip;
    }

    floor
    {
$floor
    }

    model
    {
        type            noSlip;
    }
}
